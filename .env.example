# RestroDash Environment Configuration
# Copy this file to .env.local for local dev or .env for production

# Server Binding
PORT=3000
HOSTNAME=0.0.0.0

# Security (Set a strong random secret in production)
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Payment Gateway (Optional: leave as placeholder for automatic mock checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
